{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://schemas.conda.io/menuinst-1.schema.json",
  "menu_name": "CycloDesk",
  "menu_items": [
    {
      "name": "CycloDesk",
      "description": "Point-and-click cyclostratigraphy and paleoclimate time-series analysis",
      "icon": "{{ MENU_DIR }}/cyclodesk.{{ ICON_EXT }}",
      "command": ["{{ PREFIX }}/bin/Rscript", "{{ MENU_DIR }}/cyclodesk_start.R"],
      "activate": false,
      "terminal": false,
      "platforms": {
        "win": {
          "command": ["C:\\Windows\\System32\\wscript.exe", "{{ MENU_DIR }}\\cyclodesk_start.vbs"],
          "desktop": true,
          "quicklaunch": false
        },
        "linux": {
          "Categories": ["Science", "Education", "DataVisualization"],
          "StartupWMClass": "CycloDesk"
        },
        "osx": {
          "CFBundleName": "CycloDesk",
          "CFBundleDisplayName": "CycloDesk",
          "CFBundleIdentifier": "eu.stratigraphy.cyclodesk"
        }
      }
    }
  ]
}
